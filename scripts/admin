#!/bin/sh
# Runs deploy/admin on the server with these arguments, e.g. scripts/admin new-group "Gig buddies".
set -eu
# DEPLOY_HOST as make deploy reads it. MAKEFLAGS emptied: a caller's flags (e.g. --trace) would print into it.
host=$(MAKEFLAGS='' make -s --no-print-directory -C "$(dirname "$0")/.." print-deploy-host)
[ -n "$host" ] || { echo "DEPLOY_HOST is required: set it in local.mk, see docs/operations.md" >&2; exit 1; }

# ssh joins its arguments into one remote command: single-quote each for the remote /bin/sh.
cmd=bin/admin
for arg; do
	# x: $(…) would strip the argument's trailing newlines.
	arg=$(printf '%sx' "$arg" | sed "s/'/'\\\\''/g")
	cmd="$cmd '${arg%x}'"
done
# -T: see docs/operations.md, Admin commands. -n: nothing remote reads stdin, so a caller's loop keeps it.
exec ssh -n -T "$host" "$cmd"
