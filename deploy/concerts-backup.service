# Installed by concerts install.sh, which replaces the NAME and PROXY_USER placeholders.
[Unit]
Description=@NAME@ database backup

[Service]
Type=oneshot
User=@NAME@
Group=@NAME@
Environment=CONCERTS_DB=/home/@NAME@/data/concerts.db
ExecStart=/bin/sh -c 'exec /home/@NAME@/bin/concerts backup "/home/@NAME@/backups/concerts-$(date +%%Y-%%m-%%dT%%H%%M%%S).db"'
# Keeps 14 days of snapshots; copying them off the server is up to the operator.
ExecStartPost=/usr/bin/find /home/@NAME@/backups -name 'concerts-*.db' -mtime +14 -delete
Nice=10
IOSchedulingClass=idle

ProtectHome=tmpfs
BindReadOnlyPaths=/home/@NAME@/bin
# Read-write: reading a WAL database writes its -shm.
BindPaths=/home/@NAME@/data /home/@NAME@/backups

NoNewPrivileges=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
PrivateUsers=yes
PrivateIPC=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077
LimitCORE=0
