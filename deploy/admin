#!/bin/sh
# Operates the service as its own user, from its home; installed in ~/bin by make deploy.
# Units are named after that user (install.sh's name).
# The only root actions are the sudoers grants written by install.sh.
set -eu
umask 077
cd "$HOME"

# Lists every concerts subcommand passed on below too, but serve and demo (cmd/concerts TestUsage).
usage=$(cat <<'EOF'
usage: admin <command>   (from a checkout: scripts/admin <command>)

groups:
  list-groups
  new-group "<name>"                      print the new group's link
  rotate-secret <group-id>                replace the link (the old one stops working) and print it

members:
  rename-member <group-id> <name> <new-name>   keeps their answers and concerts
  delete-member <group-id> <name>

venues:
  list-venues                             venues groups can follow, with the ids of the groups following each
  follow-venue <group-id> <venue-key>     import its upcoming concerts into the group, from the next sync
  unfollow-venue <group-id> <venue-key>   stop; deletes its imported concerts nobody answered or edited
  sync                                    run the import now, in its unit, and show its log

database:
  backup <file>                           write a consistent snapshot; <file> must not exist
  restore <backups/…>                     restore a snapshot

service:
  logs [-f]                               last 200 journal lines, or follow
  rollback                                previous binary and pre-deploy database back
  deploy                                  run by make deploy: install bin/concerts.new, restart, check
EOF
)

SNAP=backups/pre-deploy.db
# Written before a deploy's restart, removed once healthz passes (deploy, rollback or restore).
FAILED=$SNAP.deploy-failed
SYSTEMCTL='sudo -n /usr/bin/systemctl'
N=$(id -un)

# The service's own environment (root-written unit and drop-in): one source for the configuration.
eval "export $(systemctl show -P Environment $N.service)"
: "${CONCERTS_BASE_URL:?missing from $N.service: rerun make install}"
: "${CONCERTS_DB:?missing from $N.service}"
# Else the sudoers grants below, which name the sync units, are refused midway through a rollback.
systemctl cat $N-sync.timer >/dev/null 2>&1 || { echo "$N-sync.timer missing: rerun make install" >&2; exit 1; }

logs() {
	sudo -n /usr/bin/journalctl -u $N.service -u $N-backup.service -u $N-sync.service -n 200 --no-pager
}

# Through Caddy on loopback: the deployer cannot open the socket, and no hairpin NAT or DNS.
# --max-time: the socket accepts connections even when the service is down.
check() {
	hostport=${CONCERTS_BASE_URL#*://}
	hostport=${hostport%%/*}
	case $hostport in
	*:*) ;;
	*) hostport=$hostport:443 ;;
	esac
	curl -fsS --max-time 5 --resolve "$hostport:127.0.0.1" "$CONCERTS_BASE_URL/healthz" >/dev/null
}

healthz() {
	for _ in $(seq 20); do
		if check; then
			rm -f "$FAILED"
			echo "healthz ok"
			return
		fi
		sleep 1
	done
	echo "healthz failed:" >&2
	systemctl status --no-pager $N.socket $N.service >&2 || true
	logs >&2
	return 1
}

# Nothing may open the database while it is swapped: a request would start the service,
# a backup or sync would create an empty database or delete the new one's -wal on close.
# Until start_all, nothing may die of a write: once the client is gone (Ctrl-C, dropped connection),
# SIGPIPE would leave the service stopped. Hence PIPE ignored (systemctl inherits it) and no echo.
stop_all() {
	trap '' PIPE
	trap 'echo "failed with the service stopped: fix the cause, then $SYSTEMCTL start $N.socket $N-backup.timer $N-sync.timer" >&2' EXIT
	$SYSTEMCTL stop $N.socket $N.service $N-backup.timer $N-backup.service $N-sync.timer $N-sync.service
}

start_all() {
	$SYSTEMCTL reset-failed $N.service $N.socket $N-sync.service
	$SYSTEMCTL start $N.socket $N-backup.timer $N-sync.timer
	trap - EXIT
}

# Moves the live database aside to $kept (writes made since stay in it, with its -wal) and installs $1.
swap_db() {
	kept=$CONCERTS_DB.pre-$2-$(date +%Y%m%dT%H%M%S)
	for s in "" -wal -shm; do
		if [ -e "$CONCERTS_DB$s" ]; then mv "$CONCERTS_DB$s" "$kept$s"; fi
	done
	cp "$1" "$CONCERTS_DB.new"
	mv "$CONCERTS_DB.new" "$CONCERTS_DB"
}

case ${1-} in
deploy)
	test -x bin/concerts.new || { echo "bin/concerts.new missing: run make deploy" >&2; exit 1; }
	if [ -e "$FAILED" ] && [ -s "$SNAP" ] && [ -x bin/concerts.prev ] && ! check 2>/dev/null; then
		# After a failed deploy the installed binary is the broken one: keep the last good pair.
		echo "last deploy failed: keeping its pre-deploy snapshot and bin/concerts.prev" >&2
	elif [ -x bin/concerts ]; then
		# The old binary takes the snapshot: the new one would first migrate the live database.
		rm -f "$SNAP.new"
		bin/concerts backup "$SNAP.new"
		mv "$SNAP.new" "$SNAP"
		ln -f bin/concerts bin/concerts.prev
		touch "$FAILED"
	fi
	mv bin/concerts.new bin/concerts
	# The sync timer may have run the old binary, which has no sync, since the install.
	$SYSTEMCTL reset-failed $N.service $N.socket $N-sync.service
	$SYSTEMCTL restart $N.service
	healthz
	;;
rollback)
	test -x bin/concerts.prev || { echo "no bin/concerts.prev: nothing to roll back to" >&2; exit 1; }
	test -s "$SNAP" || { echo "no $SNAP: nothing to roll back to" >&2; exit 1; }
	stop_all
	swap_db "$SNAP" rollback
	ln -f bin/concerts.prev bin/concerts.tmp
	mv bin/concerts.tmp bin/concerts
	start_all
	echo "previous database kept as $kept"
	healthz
	echo "the restored database has the secrets of its time: rerun rotate-secret if a link leaked since"
	;;
restore)
	[ $# = 2 ] || { echo "$usage" >&2; exit 2; }
	case $2 in
	*..*) echo "$2: pick a snapshot in backups/" >&2; exit 2 ;;
	backups/*.db | "$HOME"/backups/*.db) ;;
	*) echo "$2: pick a snapshot in backups/" >&2; exit 2 ;;
	esac
	test -f "$2" && test -s "$2" || { echo "$2: missing or empty" >&2; exit 1; }
	stop_all
	swap_db "$2" restore
	start_all
	echo "previous database kept as $kept"
	healthz
	echo "the restored database has the secrets of its time: rerun rotate-secret if a link leaked since"
	;;
sync)
	# In its unit: same sandbox, joins a run in progress, and stopped by rollback and restore.
	status=0
	$SYSTEMCTL start $N-sync.service || status=$?
	sudo -n /usr/bin/journalctl -u $N-sync.service -n 50 --no-pager
	exit $status
	;;
logs)
	case ${2-} in
	"") logs ;;
	-f) exec sudo -n /usr/bin/journalctl -f -u $N.service -u $N-backup.service -u $N-sync.service --no-pager ;;
	*) echo "$usage" >&2; exit 2 ;;
	esac
	;;
"" | -h | --help | help)
	echo "$usage"
	;;
*)
	exec bin/concerts "$@"
	;;
esac
